# Segredo compartilhado com o Base44 — o MESMO valor vai na variável
# MTLS_RELAY_SECRET das funções base44/functions/esocialGovDireto e
# esocialGovTransmitir. Gere um valor aleatório forte (ex.: openssl rand -hex 32).
RELAY_SHARED_SECRET=

# Opcional. Lista de hosts do webservice do eSocial permitidos como destino,
# separados por vírgula. Se não definido, usa a allowlist padrão no código
# (api/relay.ts, DEFAULT_ALLOWED_HOSTS) — confirme contra a documentação
# oficial do eSocial antes de ir para produção.
# ESOCIAL_ALLOWED_HOSTS=webservices.producaorestrita.esocial.gov.br,webservices.envio.esocial.gov.br,webservices.consulta.esocial.gov.br

# Opcional. Timeout da chamada ao governo, em milissegundos (padrão 30000).
# RELAY_TIMEOUT_MS=30000
